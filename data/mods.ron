#![enable(implicit_some)]
// Mod definitions. See data/README.md for the semantics.
// Order matters: effects are applied top-to-bottom, each as a % of the *current* power,
// so stacked mods compound with diminishing absolute returns. Percentages are ESTIMATES
// based on typical dyno-reported bolt-on gains, not measurements of any particular car.
(mods: [
 (id:"turbo_kit", name:"Turbo / supercharger kit", kind:Gain,
  desc:"Bolt-on forced induction (~6-8 psi) with supporting tune. Later mods treat the car as turbocharged.",
  incompatible_note:"Not applicable to EVs.",
  effects:[
   (applies_to:[NA,Hybrid], min_pct:35, max_pct:60, torque_factor:1.1, makes_aspiration:Turbo,
    note:"Assumes a 6-8 psi kit; fuel system, clutch/driveline and a professional tune are needed."),
   (applies_to:[Turbo], min_pct:18, max_pct:35, torque_factor:1.05,
    note:"Larger turbo upgrade: expect more lag and a need for fueling upgrades."),
   (applies_to:[Supercharged], min_pct:12, max_pct:25, torque_factor:1.0,
    note:"Larger blower: fueling and tune required."),
  ]),
 (id:"intake", name:"Cold air intake", kind:Gain,
  desc:"Free-flowing intake. Gains are small on NA engines, larger on tuned turbo engines.",
  incompatible_note:"Not applicable to EVs.",
  effects:[
   (applies_to:[Turbo], requires:["tune2"], min_pct:3, max_pct:6, torque_factor:0.9),
   (applies_to:[Turbo], requires:["tune1"], min_pct:2.5, max_pct:5, torque_factor:0.9),
   (applies_to:[Turbo], min_pct:1, max_pct:3, torque_factor:0.9,
    note:"Intake gains on turbo cars are mostly unlocked by a tune."),
   (applies_to:[NA,Hybrid], min_pct:1.5, max_pct:3, torque_factor:0.9),
   (applies_to:[Supercharged], min_pct:2, max_pct:4, torque_factor:0.9),
  ]),
 (id:"headers", name:"Headers / long-tubes", kind:Gain,
  desc:"Long-tube headers or equivalent. Best on NA and supercharged V8/V6 engines.",
  incompatible_note:"Not applicable to EVs.",
  effects:[
   (applies_to:[NA,Hybrid], min_pct:3, max_pct:6, torque_factor:0.95),
   (applies_to:[Supercharged], min_pct:3, max_pct:5, torque_factor:0.95),
   (applies_to:[Turbo], min_pct:1, max_pct:2, torque_factor:0.9,
    note:"Turbo exhaust manifolds rarely offer much; a downpipe is the better upgrade."),
  ]),
 (id:"catback", name:"Cat-back exhaust", kind:Gain,
  desc:"Cat-back exhaust: mostly sound, small power gain.",
  incompatible_note:"Not applicable to EVs.",
  effects:[
   (applies_to:[NA,Hybrid], min_pct:0.8, max_pct:2, torque_factor:0.9),
   (applies_to:[Turbo,Supercharged], min_pct:1, max_pct:2.5, torque_factor:0.9),
  ]),
 (id:"throttle_body", name:"Throttle body", kind:Gain,
  desc:"Larger throttle body. Often negligible on modern drive-by-wire cars.",
  incompatible_note:"Not applicable to EVs.",
  effects:[
   (applies_to:[NA,Hybrid,Supercharged], min_pct:0.5, max_pct:1.5, torque_factor:0.9,
    note:"Throttle body gains are often within dyno noise."),
   (applies_to:[Turbo], min_pct:0, max_pct:1, torque_factor:0.9),
  ]),
 (id:"pulley", name:"Supercharger pulley swap", kind:Gain,
  desc:"Smaller supercharger pulley = more boost. Supercharged engines only.",
  incompatible_note:"A pulley swap only applies to supercharged engines.",
  effects:[
   (applies_to:[Supercharged], min_pct:8, max_pct:15, torque_factor:1.1,
    note:"More boost needs a matching tune and fuel upgrades."),
  ]),
 (id:"downpipe", name:"Downpipe (turbo only)", kind:Gain,
  desc:"Less restrictive turbo outlet. Turbo engines only; works best with a tune.",
  incompatible_note:"A downpipe only applies to turbocharged engines.",
  effects:[
   (applies_to:[Turbo], requires:["tune2"], min_pct:9, max_pct:15, torque_factor:1.05),
   (applies_to:[Turbo], requires:["tune1"], min_pct:7, max_pct:12, torque_factor:1.05),
   (applies_to:[Turbo], min_pct:3, max_pct:6, torque_factor:1.0,
    note:"Without a tune a downpipe gains little and may trigger fault codes."),
  ]),
 (id:"intercooler", name:"Intercooler upgrade (turbo only)", kind:Gain,
  desc:"Bigger intercooler: cooler charge air, less heat soak. Turbo engines only.",
  incompatible_note:"An intercooler upgrade only applies to turbocharged engines.",
  effects:[ (applies_to:[Turbo], min_pct:2, max_pct:5, torque_factor:1.0) ]),
 (id:"tune1", name:"ECU tune - Stage 1", kind:Gain, conflicts:["tune2"],
  desc:"Software-only tune. Large percentage on turbo engines, small on NA.",
  incompatible_note:"Not applicable to EVs.",
  effects:[
   (applies_to:[Turbo], min_pct:12, max_pct:25, torque_factor:1.1),
   (applies_to:[Supercharged], min_pct:6, max_pct:12, torque_factor:1.0),
   (applies_to:[NA,Hybrid], min_pct:1, max_pct:3, torque_factor:0.9),
  ]),
 (id:"tune2", name:"ECU tune - Stage 2", kind:Gain, conflicts:["tune1"],
  desc:"Tune for supporting hardware (intake/downpipe/headers).",
  incompatible_note:"Not applicable to EVs.",
  effects:[
   (applies_to:[Turbo], requires:["downpipe"], min_pct:20, max_pct:35, torque_factor:1.1),
   (applies_to:[Turbo], min_pct:14, max_pct:25, torque_factor:1.1,
    note:"Stage 2 is meant to be paired with a downpipe; gains reduced without one."),
   (applies_to:[Supercharged], min_pct:12, max_pct:20, torque_factor:1.0),
   (applies_to:[NA,Hybrid], requires:["headers"], min_pct:4, max_pct:7, torque_factor:0.95),
   (applies_to:[NA,Hybrid], min_pct:2, max_pct:4, torque_factor:0.9,
    note:"Stage 2 on an NA car pays off mostly with headers."),
  ]),
 (id:"e85", name:"E85 / flex-fuel tune", kind:Gain, fuels:[Gas,Flex],
  desc:"Ethanol fuel tune. Larger gain on boosted engines (knock resistance).",
  incompatible_note:"E85 tune applies to gasoline engines only.",
  effects:[
   (applies_to:[Turbo], min_pct:8, max_pct:18, torque_factor:1.1,
    note:"Needs E85 fuel, a flex sensor and usually a bigger fuel system."),
   (applies_to:[Supercharged], min_pct:6, max_pct:12, torque_factor:1.05,
    note:"Needs E85 fuel, a flex sensor and usually a bigger fuel system."),
   (applies_to:[NA,Hybrid], min_pct:3, max_pct:6, torque_factor:1.0,
    note:"Needs E85 fuel and a flex-fuel tune."),
  ]),
 (id:"nitrous", name:"Nitrous (wet shot)", kind:Gain, fuels:[Gas,Flex,Hybrid],
  desc:"Nominal shot size in hp at the crank.",
  slider:(label:"Shot size", unit:"hp", min:50, max:150, default:75, step:25),
  incompatible_note:"Nitrous is not applicable to this fuel/engine type.",
  effects:[
   (applies_to:[NA,Turbo,Supercharged,Hybrid], unit_hp_min:0.9, unit_hp_max:1.0, torque_factor:1.1,
    note:"Short bursts only; check engine internals, plugs, fuel and bottle pressure."),
  ]),
 (id:"weight_red", name:"Weight reduction", kind:Gain,
  desc:"Stripped interior, lighter wheels/battery, etc.",
  slider:(label:"Weight removed", unit:"lb", min:0, max:500, default:100, step:10),
  effects:[ (unit_lbs:-1) ]),
 (id:"tires", name:"Sticky tires / launch setup (0-60 only)", kind:Gain,
  desc:"Better rubber and launch technique. Affects only the 0-60 estimate, mostly on powerful cars.",
  effects:[ (traction_pct:25, zs_pct_min:-3, zs_pct_max:-1) ]),

 // ---- Negative modifiers / conditions ----
 (id:"passengers", name:"Passengers", kind:Negative,
  desc:"Added weight from people in the car.",
  slider:(label:"Passenger weight", unit:"lb", min:0, max:800, default:170, step:10),
  effects:[ (unit_lbs:1) ]),
 (id:"cargo", name:"Cargo", kind:Negative,
  desc:"Added weight from luggage/cargo.",
  slider:(label:"Cargo weight", unit:"lb", min:0, max:1000, default:200, step:10),
  effects:[ (unit_lbs:1) ]),
 (id:"roof_rack", name:"Roof rack", kind:Negative,
  desc:"Rack weight plus a little extra drag.",
  effects:[ (weight_lbs:45, zs_pct_min:0.3, zs_pct_max:1.0) ]),
 (id:"altitude", name:"High altitude", kind:Negative,
  desc:"SAE-style rule of thumb: about 3% power loss per 1000 ft for NA engines; turbos lose much less.",
  slider:(label:"Elevation", unit:"ft", min:0, max:14000, default:5000, step:500),
  effects:[
   (applies_to:[NA,Hybrid], unit_pct_min:-3.3, unit_pct_max:-2.7, unit_div:1000),
   (applies_to:[Supercharged], unit_pct_min:-2.6, unit_pct_max:-1.8, unit_div:1000),
   (applies_to:[Turbo], unit_pct_min:-1.5, unit_pct_max:-0.5, unit_div:1000,
    note:"Turbo loss assumes the turbo is not out of boost/compressor-map range."),
   (applies_to:[EV], unit_pct_min:0, unit_pct_max:0, unit_div:1000),
  ]),
 (id:"heat", name:"Hot ambient temperature", kind:Negative,
  desc:"Intake heat soak / less dense air, relative to a 77 F baseline.",
  slider:(label:"Degrees above 77 F", unit:"F", min:0, max:45, default:20, step:5),
  effects:[
   (applies_to:[NA,Hybrid], unit_pct_min:-0.12, unit_pct_max:-0.08),
   (applies_to:[Supercharged], unit_pct_min:-0.15, unit_pct_max:-0.10),
   (applies_to:[Turbo], unit_pct_min:-0.20, unit_pct_max:-0.12),
   (applies_to:[EV], unit_pct_min:-0.06, unit_pct_max:-0.02),
  ]),
 (id:"worn", name:"Worn engine / high mileage", kind:Negative,
  desc:"Compression loss, aged sensors/battery.",
  effects:[ (min_pct:-8, max_pct:-3) ]),
 (id:"restrictive", name:"Restrictive aftermarket parts", kind:Negative,
  desc:"Poorly designed intake, cheap high-flow cats, etc.",
  incompatible_note:"Not applicable to EVs.",
  effects:[ (applies_to:[NA,Turbo,Supercharged,Hybrid], min_pct:-4, max_pct:-1) ]),
 (id:"custom", name:"Custom +/- hp", kind:Negative,
  desc:"Enter your own hp adjustment (dyno result, known gain, etc).",
  slider:(label:"Adjustment", unit:"hp", min:-200, max:200, default:10, step:5),
  effects:[ (unit_hp_min:1, unit_hp_max:1) ]),
])
