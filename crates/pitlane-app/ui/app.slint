import { ComboBox, Slider, LineEdit, TextEdit, ScrollView, Palette } from "std-widgets.slint";

// Layout rules (all sizes are logical px = dp on Android):
//  * every touch target is at least 48px (Android guideline), even where the visible pill is smaller;
//  * phone   = shortest side < 520px: one compact top bar, Build / Compare in a bottom bar;
//  * tablet portrait / small window: same, with the full comparison table;
//  * wide    = width >= 840px: Build panel and comparison side by side, no bottom bar;
//  * the content is inset by the platform safe area (status/navigation bar, notch) and lifted
//    above the on-screen keyboard;
//  * status messages appear in a small bar that hides itself (a single-shot timer, nothing ticks idle).

export struct SlotInfo { title: string, subtitle: string, modded: bool, color: color }
export struct CellData { text: string, sub: string, best: bool, frac: float }
export struct RowData { label: string, cells: [CellData] }
export struct StatData { label: string, value: string, delta: string, changed: bool, better: bool }
export struct ModRow {
    id: string, name: string, desc: string, enabled: bool,
    has-slider: bool, value: float, min: float, max: float, step: float,
    slider-label: string, value-text: string, gain: string, warning: string,
}
export struct SavedItem { name: string, detail: string }

export global Backend {
    // ---- data in ----
    in property <[SlotInfo]> slots;
    in-out property <int> selected;
    in property <[string]> years;
    in-out property <int> year-index;
    in property <[string]> makes;
    in-out property <int> make-index;
    in property <[string]> models;
    in-out property <int> model-index;
    in property <[string]> trims;
    in-out property <int> trim-index;
    // drivetrains the selected trim was sold with (empty or one entry: no choice to show)
    in property <[string]> drives;
    in-out property <int> drive-index;
    in property <bool> has-car;
    in property <string> selected-title;
    in property <[StatData]> stats;
    in property <string> detail-line;
    in property <string> mod-note;
    in property <int> active-mods;
    in property <bool> is-fav;
    in property <[ModRow]> gain-mods;
    in property <[ModRow]> neg-mods;
    in property <[SlotInfo]> headers;
    in property <[RowData]> rows;
    in property <[RowData]> compact-rows;
    // charts: label = chart title, cells = one bar per car
    in property <[RowData]> charts;
    in property <[string]> search-hits;
    in-out property <string> search-text;
    in property <[string]> favorites;
    in property <[SavedItem]> saved;
    in property <string> units-text;
    in property <string> power-text;
    in property <string> wheel-text;
    in property <string> status;
    in property <string> data-note;
    // 0 = table, 1 = cards
    in-out property <int> view-mode;
    in-out property <int> dialog;
    in-out property <string> export-text;
    in-out property <int> export-kind;
    in-out property <string> overrides-text;
    in-out property <string> save-name;
    // edit-car form
    in-out property <string> ed-make;
    in-out property <string> ed-model;
    in-out property <string> ed-trim;
    in-out property <string> ed-year;
    in-out property <string> ed-disp;
    in-out property <string> ed-cyl;
    in-out property <string> ed-hp;
    in-out property <string> ed-tq;
    in-out property <string> ed-zs;
    in-out property <string> ed-weight;
    in-out property <string> ed-rl;
    in-out property <int> ed-asp;
    in-out property <int> ed-dt;
    in property <string> ed-heading;
    in property <bool> ed-new;
    in property <bool> ed-can-reset;
    // loss settings (percent)
    in-out property <string> loss-2wd-man;
    in-out property <string> loss-2wd-auto;
    in-out property <string> loss-awd-man;
    in-out property <string> loss-awd-auto;
    in-out property <string> loss-ev;

    // ---- events out ----
    callback select-slot(int);
    callback add-slot();
    callback remove-slot();
    callback duplicate-slot();
    callback year-picked(int);
    callback make-picked(int);
    callback model-picked(int);
    callback trim-picked(int);
    callback drive-picked(int);
    callback mod-toggled(string, bool);
    callback mod-value(string, float);
    callback search-edited(string);
    callback search-pick(int);
    callback toggle-units();
    callback cycle-power();
    callback toggle-wheel();
    callback toggle-fav();
    callback pick-fav(int);
    callback save-comparison();
    callback load-saved(int);
    callback delete-saved(int);
    callback export-png();
    callback export-open(int);
    callback copy-export();
    callback save-export();
    callback open-edit(bool);
    callback edit-save(bool);
    callback edit-reset();
    callback overrides-open();
    callback overrides-copy();
    callback overrides-import();
    callback settings-save();
    callback clear-status();
}

global Ui {
    out property <length> touch: 48px;
    out property <color> good: #2e9b3a;
    out property <color> warn: #d9822b;
    out property <color> best-bg: #2e7d3238;
}

component PButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <color> dot: transparent;
    in property <length> font: 14px;
    callback clicked();
    min-height: Ui.touch;
    min-width: Ui.touch;
    preferred-width: lbl.preferred-width + 28px + (root.dot == transparent ? 0px : 14px);
    border-radius: 8px;
    border-width: 1px;
    border-color: root.dot == transparent ? Palette.border : root.dot;
    background: root.active ? Palette.accent-background : (ta.pressed ? Palette.border : Palette.alternate-background);
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 6px; alignment: center;
        if root.dot != transparent: Rectangle { width: 8px; height: 8px; y: (parent.height - self.height) / 2; border-radius: 4px; background: root.dot; }
        lbl := Text {
            text: root.text; font-size: root.font; vertical-alignment: center; horizontal-alignment: center; overflow: elide;
            color: root.active ? Palette.accent-foreground : Palette.foreground;
        }
    }
}

// A small pill with a full 48px touch area: visually light, still easy to hit.
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();
    min-height: Ui.touch;
    min-width: Ui.touch;
    preferred-width: lbl.preferred-width + 24px;
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea { clicked => { root.clicked(); } }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 34px;
        border-radius: 17px;
        border-width: 1px;
        border-color: root.active ? Palette.accent-background : Palette.border;
        background: root.active ? Palette.accent-background : (ta.pressed ? Palette.border : transparent);
        lbl := Text {
            text: root.text; font-size: 13px; overflow: elide; horizontal-alignment: center; vertical-alignment: center;
            width: parent.width - 16px;
            color: root.active ? Palette.accent-foreground : Palette.foreground;
        }
    }
}

// Two or more options in one rounded control (Table | Cards).
component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback picked(int);
    min-height: Ui.touch;
    HorizontalLayout {
        padding-top: 7px; padding-bottom: 7px;
        for o[i] in root.options: Rectangle {
            horizontal-stretch: 1;
            border-radius: 8px;
            background: i == root.current ? Palette.accent-background : Palette.alternate-background;
            accessible-role: button;
            accessible-label: o;
            accessible-action-default => { root.current = i; root.picked(i); }
            TouchArea { y: -7px; height: parent.height + 14px; clicked => { root.current = i; root.picked(i); } }
            Text { text: o; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; color: i == root.current ? Palette.accent-foreground : Palette.foreground; }
        }
    }
}

component Cell inherits Rectangle {
    in property <CellData> d;
    background: d.best ? Ui.best-bg : transparent;
    border-radius: 6px;
    VerticalLayout {
        padding: 5px; spacing: 1px;
        Text { text: d.text; font-weight: d.best ? 700 : 400; wrap: word-wrap; horizontal-alignment: center; font-size: 14px; color: Palette.foreground; }
        if d.sub != "": Text { text: d.sub; font-size: 11px; wrap: word-wrap; horizontal-alignment: center; color: Palette.foreground.with-alpha(0.6); }
    }
}

component CompareTable inherits Rectangle {
    in property <[SlotInfo]> headers;
    in property <[RowData]> rows;
    in property <length> label-w: 120px;
    in property <length> min-col-w: 96px;
    property <length> col-w: max(root.min-col-w, (root.width - root.label-w) / max(1, root.headers.length));
    preferred-height: col.preferred-height;
    col := VerticalLayout {
        spacing: 2px;
        alignment: start;
        HorizontalLayout {
            Rectangle { width: root.label-w; }
            for h[i] in root.headers: Rectangle {
                width: root.col-w;
                VerticalLayout {
                    padding: 4px; spacing: 1px;
                    Rectangle { height: 4px; background: h.color; border-radius: 2px; }
                    Text { text: h.title; font-weight: 700; font-size: 13px; wrap: word-wrap; horizontal-alignment: center; color: Palette.foreground; }
                    Text { text: h.subtitle; font-size: 11px; wrap: word-wrap; horizontal-alignment: center; color: Palette.foreground.with-alpha(0.65); }
                }
            }
        }
        for row[ri] in root.rows: Rectangle {
            background: Math.mod(ri, 2) == 0 ? Palette.alternate-background.with-alpha(0.5) : transparent;
            border-radius: 6px;
            HorizontalLayout {
                Rectangle {
                    width: root.label-w;
                    Text { x: 6px; width: parent.width - 10px; text: row.label; font-size: 12px; wrap: word-wrap; vertical-alignment: center; color: Palette.foreground.with-alpha(0.75); }
                }
                for c in row.cells: Cell { width: root.col-w; d: c; }
            }
        }
    }
}

component CarCard inherits Rectangle {
    in property <SlotInfo> info;
    in property <[RowData]> rows;
    in property <int> index;
    background: Palette.alternate-background;
    border-radius: 12px;
    border-width: 2px;
    border-color: root.info.color;
    preferred-height: v.preferred-height;
    v := VerticalLayout {
        padding: 12px; spacing: 2px;
        alignment: start;
        Text { text: root.info.title; font-size: 17px; font-weight: 700; wrap: word-wrap; color: Palette.foreground; }
        Text { text: root.info.subtitle + (root.info.modded ? "  -  modded (est.)" : ""); font-size: 12px; wrap: word-wrap; color: Palette.foreground.with-alpha(0.7); }
        Rectangle { height: 4px; }
        for row in root.rows: HorizontalLayout {
            spacing: 8px;
            Text { text: row.label; width: 40%; font-size: 12px; wrap: word-wrap; vertical-alignment: center; color: Palette.foreground.with-alpha(0.7); }
            Cell { horizontal-stretch: 1; d: row.cells[root.index]; }
        }
    }
}

// One card per car; swipe horizontally (or use the arrows) to page.
component CardPager inherits Rectangle {
    in property <[SlotInfo]> headers;
    in property <[RowData]> rows;
    in-out property <int> page: 0;
    property <length> drag: 0px;
    property <bool> dragging: false;
    property <int> count: root.headers.length;
    property <int> current: max(0, min(root.page, root.count - 1));
    preferred-height: lay.preferred-height;
    lay := VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            height: Ui.touch; spacing: 10px; alignment: center;
            Chip { text: "‹ Prev"; clicked => { if (root.current > 0) { root.page = root.current - 1; } } }
            for h[i] in root.headers: Rectangle {
                width: 18px;
                Rectangle { width: 10px; height: 10px; border-radius: 5px; background: i == root.current ? h.color : h.color.with-alpha(0.3); }
                TouchArea { clicked => { root.page = i; } }
            }
            Chip { text: "Next ›"; clicked => { if (root.current < root.count - 1) { root.page = root.current + 1; } } }
        }
        Rectangle {
            clip: true;
            // The invisible copy of the current card gives the pager its height (min-height: a
            // ScrollView sizes its content from the minimum height).
            min-height: measure.preferred-height;
            measure := CarCard {
                x: 4px; width: parent.width - 8px; opacity: 0;
                info: root.headers[root.current]; rows: root.rows; index: root.current;
            }
            for h[i] in root.headers: CarCard {
                x: (i - root.current) * parent.width + root.drag + 4px;
                y: 0px;
                width: parent.width - 8px;
                height: parent.height;
                info: h; rows: root.rows; index: i;
                animate x { duration: root.dragging ? 0ms : 180ms; easing: ease-out; }
            }
            TouchArea {
                moved => {
                    if (self.pressed) { root.dragging = true; root.drag = self.mouse-x - self.pressed-x; }
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                        if (root.drag < -50px && root.current < root.count - 1) { root.page = root.current + 1; }
                        else if (root.drag > 50px && root.current > 0) { root.page = root.current - 1; }
                        root.drag = 0px;
                        root.dragging = false;
                    }
                }
            }
        }
    }
}

// Bar charts drawn with plain rectangles (no images, nothing re-rendered unless data changes).
component Charts inherits Rectangle {
    in property <[RowData]> charts;
    in property <[SlotInfo]> headers;
    in property <length> value-w: 120px;
    preferred-height: v.preferred-height;
    v := VerticalLayout {
        spacing: 14px;
        for ch in root.charts: VerticalLayout {
            spacing: 4px;
            Text { text: ch.label; font-weight: 700; font-size: 13px; wrap: word-wrap; color: Palette.foreground; }
            for b[i] in ch.cells: HorizontalLayout {
                spacing: 6px;
                Rectangle { width: 22px; Text { text: "#" + (i + 1); font-size: 12px; vertical-alignment: center; color: root.headers[i].color; font-weight: 700; } }
                Rectangle {
                    horizontal-stretch: 1; height: 18px; y: 2px; background: Palette.alternate-background; border-radius: 4px;
                    Rectangle { x: 0px; width: parent.width * max(0.03, b.frac); height: parent.height; border-radius: 4px; background: b.best ? #2e7d32 : root.headers[i].color.with-alpha(0.75); }
                }
                Rectangle { width: root.value-w; Text { width: parent.width; text: b.text; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; font-weight: b.best ? 700 : 400; color: Palette.foreground; } }
            }
        }
    }
}

component StatTile inherits Rectangle {
    in property <StatData> d;
    border-radius: 8px;
    background: d.changed ? (d.better ? Ui.best-bg : Ui.warn.with-alpha(0.15)) : Palette.alternate-background;
    min-height: v.preferred-height;
    v := VerticalLayout {
        padding: 6px; spacing: 0px; alignment: center;
        Text { text: d.value; font-size: 15px; font-weight: 700; horizontal-alignment: center; overflow: elide; color: Palette.foreground; }
        Text { text: d.delta != "" ? d.delta : d.label; font-size: 11px; horizontal-alignment: center; overflow: elide; color: d.changed ? (d.better ? Ui.good : Ui.warn) : Palette.foreground.with-alpha(0.6); }
    }
}

component ModItem inherits Rectangle {
    in property <ModRow> m;
    callback toggled(bool);
    callback changed(float);
    background: m.enabled ? Palette.alternate-background : transparent;
    border-radius: 8px;
    preferred-height: v.preferred-height;
    TouchArea { y: 0px; height: Ui.touch; clicked => { root.toggled(!root.m.enabled); } }
    v := VerticalLayout {
        padding-left: 6px; padding-right: 6px; padding-bottom: root.m.enabled ? 6px : 0px; spacing: 2px;
        HorizontalLayout {
            height: Ui.touch; spacing: 10px;
            Rectangle {
                width: 24px; height: 24px; y: (parent.height - self.height) / 2; border-radius: 6px; border-width: 2px; border-color: Palette.accent-background;
                background: root.m.enabled ? Palette.accent-background : transparent;
                accessible-role: checkbox;
                accessible-checkable: true;
                accessible-checked: root.m.enabled;
                accessible-label: root.m.name;
                accessible-action-default => { root.toggled(!root.m.enabled); }
                Text { text: root.m.enabled ? "✓" : ""; color: Palette.accent-foreground; horizontal-alignment: center; vertical-alignment: center; font-weight: 700; }
            }
            Text { text: root.m.name; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; font-weight: root.m.enabled ? 600 : 400; font-size: 14px; color: Palette.foreground; }
            if root.m.warning != "" && !root.m.enabled: Text { text: "!"; font-weight: 700; vertical-alignment: center; color: Ui.warn; }
        }
        if root.m.enabled && root.m.has-slider: HorizontalLayout {
            spacing: 8px; height: Ui.touch;
            Slider {
                minimum: root.m.min; maximum: root.m.max; value: root.m.value; step: root.m.step; height: Ui.touch;
                horizontal-stretch: 1;
                accessible-label: root.m.slider-label;
                changed(v) => { root.changed(v); }
            }
            Text { text: root.m.value-text; width: 76px; vertical-alignment: center; horizontal-alignment: right; font-size: 13px; font-weight: 700; color: Palette.foreground; }
        }
        if root.m.enabled && root.m.gain != "": Text { text: root.m.gain; font-size: 12px; wrap: word-wrap; color: Ui.good; }
        if root.m.warning != "" && root.m.enabled: Text { text: root.m.warning; font-size: 12px; wrap: word-wrap; color: Ui.warn; }
    }
}

component Section inherits Text {
    font-size: 15px; font-weight: 700; wrap: word-wrap; color: Palette.foreground;
}

component Caption inherits Text {
    font-size: 12px; wrap: word-wrap; color: Palette.foreground.with-alpha(0.65);
}

component LabeledField inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> value;
    in property <InputType> kind: InputType.text;
    in property <bool> read-only: false;
    spacing: 8px;
    Text { text: root.label; min-width: 72px; preferred-width: 120px; horizontal-stretch: 0; vertical-alignment: center; wrap: word-wrap; font-size: 13px; color: Palette.foreground; }
    LineEdit { text <=> root.value; input-type: root.kind; read-only: root.read-only; height: Ui.touch; min-width: 64px; horizontal-stretch: 1; }
}

component Picker inherits ComboBox {
    callback picked(int);
    height: Ui.touch;
    selected => { root.picked(self.current-index); }
}

component BuildPanel inherits ScrollView {
    in-out property <bool> show-all-mods: false;
    VerticalLayout {
        padding: 12px; spacing: 10px;
        alignment: start;
        LineEdit {
            placeholder-text: "Search: 2005 ranger, 06 civic si, lx570";
            text <=> Backend.search-text;
            input-type: InputType.search;
            height: Ui.touch;
            edited(t) => { Backend.search-edited(t); }
        }
        for hit[i] in Backend.search-hits: PButton { text: hit; active: false; clicked => { Backend.search-pick(i); } }

        // cars in the comparison
        HorizontalLayout {
            spacing: 6px;
            for s[i] in Backend.slots: PButton {
                text: "#" + (i + 1); dot: s.color; active: i == Backend.selected; min-width: 52px; horizontal-stretch: 1; max-width: 72px;
                clicked => { Backend.select-slot(i); }
            }
            if Backend.slots.length < 5: PButton { text: Backend.slots.length == 0 ? "+ Add car" : "+"; min-width: 52px; clicked => { Backend.add-slot(); } }
            Rectangle { horizontal-stretch: 0.01; }
        }

        if !Backend.has-car: Rectangle {
            background: Palette.alternate-background; border-radius: 8px;
            VerticalLayout {
                padding: 12px; spacing: 4px;
                Text { text: "No cars yet"; font-size: 17px; font-weight: 700; color: Palette.foreground; }
                Caption { text: "Search above (e.g. \"2005 ford ranger\" or \"ranger 4.0\"), or tap + to add a car and pick it with Year / Make / Model / Engine."; font-size: 13px; }
            }
        }

        if Backend.has-car: VerticalLayout {
            spacing: 8px;
            // title + compact actions
            HorizontalLayout {
                spacing: 4px;
                Text { text: Backend.selected-title; font-size: 17px; font-weight: 700; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; color: Palette.foreground; }
                Chip { text: Backend.is-fav ? "★" : "☆"; active: Backend.is-fav; accessible-label: Backend.is-fav ? "Remove favorite" : "Add favorite"; clicked => { Backend.toggle-fav(); } }
                Chip { text: "Copy"; accessible-label: "Duplicate this car"; clicked => { Backend.duplicate-slot(); } }
                Chip { text: "Remove"; accessible-label: "Remove this car"; clicked => { Backend.remove-slot(); } }
            }
            // pickers: year + make on one row, then model, then engine
            HorizontalLayout {
                spacing: 8px;
                Picker { width: 104px; model: Backend.years; current-index <=> Backend.year-index; accessible-label: "Year"; picked(i) => { Backend.year-picked(i); } }
                Picker { horizontal-stretch: 1; model: Backend.makes; current-index <=> Backend.make-index; accessible-label: "Make"; picked(i) => { Backend.make-picked(i); } }
            }
            Picker { model: Backend.models; current-index <=> Backend.model-index; accessible-label: "Model"; picked(i) => { Backend.model-picked(i); } }
            Picker { model: Backend.trims; current-index <=> Backend.trim-index; accessible-label: "Trim / engine"; picked(i) => { Backend.trim-picked(i); } }
            // only for trims sold with more than one drivetrain (e.g. 2WD / 4WD trucks)
            if Backend.drives.length > 1: Segmented {
                options: Backend.drives; current <=> Backend.drive-index;
                picked(i) => { Backend.drive-picked(i); }
            }
            // headline numbers
            HorizontalLayout {
                spacing: 6px;
                for st in Backend.stats: StatTile { d: st; horizontal-stretch: 1; }
            }
            Caption { text: Backend.detail-line; }
            if Backend.mod-note != "": Caption { text: Backend.mod-note; color: Palette.foreground.with-alpha(0.8); }

            // mods: only the active ones unless expanded
            HorizontalLayout {
                spacing: 8px;
                Section { text: Backend.active-mods == 0 ? "Mods" : "Mods (" + Backend.active-mods + " on)"; vertical-alignment: center; horizontal-stretch: 1; }
                Chip {
                    text: root.show-all-mods ? "Done" : (Backend.active-mods == 0 ? "Add mods" : "Edit mods");
                    active: root.show-all-mods;
                    clicked => { root.show-all-mods = !root.show-all-mods; }
                }
            }
            if Backend.active-mods == 0 && !root.show-all-mods: Caption { text: "Stock. Tap 'Add mods' for bolt-ons, tunes, nitrous, weight and conditions like altitude or passengers."; }
            if root.show-all-mods: Caption { text: "Performance"; font-weight: 700; }
            VerticalLayout {
                for m in Backend.gain-mods: VerticalLayout {
                    padding-bottom: (m.enabled || root.show-all-mods) ? 4px : 0px;
                    if m.enabled || root.show-all-mods: ModItem {
                        m: m;
                        toggled(on) => { Backend.mod-toggled(m.id, on); }
                        changed(v) => { Backend.mod-value(m.id, v); }
                    }
                }
            }
            if root.show-all-mods: Caption { text: "Conditions & negatives"; font-weight: 700; }
            VerticalLayout {
                for m in Backend.neg-mods: VerticalLayout {
                    padding-bottom: (m.enabled || root.show-all-mods) ? 4px : 0px;
                    if m.enabled || root.show-all-mods: ModItem {
                        m: m;
                        toggled(on) => { Backend.mod-toggled(m.id, on); }
                        changed(v) => { Backend.mod-value(m.id, v); }
                    }
                }
            }
        }
        Text { text: Backend.data-note; font-size: 11px; wrap: word-wrap; color: Palette.foreground.with-alpha(0.5); }
    }
}

component ComparePanel inherits ScrollView {
    in property <bool> narrow;
    // narrow screens show the key rows unless "All specs" is on
    property <bool> all-specs: false;
    // three cars fit side by side on a 320px phone; more scroll sideways
    property <length> label-w: root.width < 360px ? 64px : root.width < 420px ? 72px : 120px;
    property <length> min-col-w: root.width < 360px ? 76px : root.width < 420px ? 80px : 100px;
    VerticalLayout {
        padding: root.width < 360px ? 8px : 12px; spacing: 10px;
        alignment: start;
        if Backend.headers.length == 0: Text { text: "Nothing to compare yet. Add cars on the Build tab: search for one or tap +."; font-size: 14px; wrap: word-wrap; color: Palette.foreground.with-alpha(0.75); }
        if Backend.headers.length > 0: HorizontalLayout {
            spacing: 8px;
            Segmented { options: ["Table", "Cards"]; current <=> Backend.view-mode; horizontal-stretch: 1; max-width: 280px; }
            Rectangle { horizontal-stretch: 0.001; }
            if root.narrow && Backend.view-mode == 0: Chip { text: root.all-specs ? "Key specs" : "All specs"; clicked => { root.all-specs = !root.all-specs; } }
        }
        if Backend.headers.length > 0 && Backend.view-mode == 1: CardPager { headers: Backend.headers; rows: Backend.rows; }
        if Backend.headers.length > 0 && Backend.view-mode == 0: ScrollView {
            content-width: max(self.visible-width, root.label-w + max(1, Backend.headers.length) * root.min-col-w);
            min-height: table.preferred-height;
            table := CompareTable {
                width: parent.content-width;
                headers: Backend.headers;
                rows: (root.narrow && !root.all-specs) ? Backend.compact-rows : Backend.rows;
                label-w: root.label-w; min-col-w: root.min-col-w;
            }
        }
        if Backend.headers.length > 0: Section { text: "Charts"; }
        Charts { charts: Backend.charts; headers: Backend.headers; value-w: root.width < 420px ? 92px : 120px; }
        if Backend.headers.length > 0: Caption { text: "Modded numbers are estimates (est.). Best value per row is highlighted."; font-size: 11px; }
    }
}

component DialogFrame inherits Rectangle {
    in property <string> title;
    in property <length> pad-bottom: 0px;
    callback close();
    background: #000000a0;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        property <length> margin: root.width < 520px ? 8px : 24px;
        width: min(parent.width - 2 * self.margin, 600px);
        height: min(parent.height - 2 * self.margin - root.pad-bottom, 760px);
        y: (parent.height - root.pad-bottom - self.height) / 2;
        background: Palette.background; border-radius: 12px; border-width: 1px; border-color: Palette.border;
        TouchArea { }
        VerticalLayout {
            padding: 12px; spacing: 8px;
            HorizontalLayout {
                height: Ui.touch; spacing: 8px;
                Text { text: root.title; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; color: Palette.foreground; }
                PButton { text: "Close"; width: 84px; clicked => { root.close(); } }
            }
            if Backend.status != "": Text { text: Backend.status; font-size: 12px; wrap: word-wrap; color: Ui.warn; }
            ScrollView {
                vertical-stretch: 1;
                // never scroll sideways: content always fits the dialog width
                content-width: self.visible-width;
                VerticalLayout {
                    spacing: 8px;
                    @children
                }
            }
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    accessible-role: tab;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    TouchArea { clicked => { root.clicked(); } }
    Rectangle {
        width: min(parent.width - 16px, 140px); height: 34px;
        border-radius: 17px;
        background: root.active ? Palette.accent-background.with-alpha(0.18) : transparent;
        Text { text: root.text; font-size: 14px; font-weight: root.active ? 700 : 400; color: root.active ? Palette.accent-background : Palette.foreground.with-alpha(0.75); }
    }
}

export component MainWindow inherits Window {
    title: "Pitlane";
    icon: @image-url("../assets/icon.png");
    min-width: 320px;
    min-height: 480px;
    preferred-width: 1100px;
    preferred-height: 760px;
    background: Palette.background;
    in-out property <int> tab: 0;
    // insets: system bars / notch, plus the on-screen keyboard when it is up
    property <length> inset-top: root.safe-area-insets.top;
    property <length> inset-left: root.safe-area-insets.left;
    property <length> inset-right: root.safe-area-insets.right;
    property <length> inset-bottom: max(root.safe-area-insets.bottom, root.virtual-keyboard-size.height);
    property <length> avail-w: root.width - root.inset-left - root.inset-right;
    property <length> avail-h: root.height - root.inset-top - root.inset-bottom;
    property <bool> phone: min(root.avail-w, root.avail-h) < 520px;
    property <bool> wide: root.avail-w >= 840px && !(root.phone && root.avail-h < 420px);
    property <bool> keyboard-up: root.virtual-keyboard-size.height > 0px;
    // short landscape screens: tabs move into the top bar instead of taking a bottom bar
    property <bool> tabs-on-top: !root.wide && root.avail-h < 480px;
    property <length> build-w: clamp(root.avail-w * 0.38, 360px, 460px);

    // Return keyboard focus to the root after a dialog or tab change so Escape / Android Back keep working.
    property <int> dialog-watch: Backend.dialog;
    property <int> tab-watch: root.tab;
    changed dialog-watch => { fs.focus(); }
    changed tab-watch => { fs.focus(); }

    fs := FocusScope {
        x: 0px; y: 0px; width: root.width; height: root.height;
        init => { self.focus(); }
        // Key events from focused children (LineEdit, ComboBox ...) bubble up here when unhandled.
        key-pressed(e) => {
            if (e.text == Key.Escape || e.text == Key.Back) {
                if (Backend.dialog != 0) { Backend.dialog = 0; return accept; }
                if (Backend.search-hits.length > 0) { Backend.search-text = ""; Backend.search-edited(""); return accept; }
                if (root.tab != 0 && !root.wide) { root.tab = 0; return accept; }
            }
            // unhandled Back at the top level falls through to Android (leaves the app)
            reject
        }

        VerticalLayout {
            padding-top: root.inset-top;
            padding-left: root.inset-left;
            padding-right: root.inset-right;
            padding-bottom: root.inset-bottom;
            // one compact top bar: name, unit switches, menu
            Rectangle {
                background: Palette.alternate-background;
                height: Ui.touch + 8px;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 4px; spacing: 4px;
                    if root.avail-w >= 360px: Text { text: "Pitlane"; font-size: 18px; font-weight: 800; vertical-alignment: center; color: Palette.accent-background; }
                    if root.tabs-on-top: Chip { text: "Build"; active: root.tab == 0; clicked => { root.tab = 0; } }
                    if root.tabs-on-top: Chip { text: Backend.headers.length > 0 ? "Compare (" + Backend.headers.length + ")" : "Compare"; active: root.tab == 1; clicked => { root.tab = 1; } }
                    Rectangle { horizontal-stretch: 1; }
                    Chip { text: Backend.units-text; accessible-label: "Units: " + Backend.units-text; clicked => { Backend.toggle-units(); } }
                    Chip { text: Backend.power-text; accessible-label: "Power unit: " + Backend.power-text; clicked => { Backend.cycle-power(); } }
                    Chip { text: Backend.wheel-text; accessible-label: "Power measured at: " + Backend.wheel-text; clicked => { Backend.toggle-wheel(); } }
                    Chip { text: "☰"; accessible-label: "Menu"; clicked => { Backend.dialog = 6; } }
                }
            }
            if root.wide: HorizontalLayout {
                vertical-stretch: 1;
                BuildPanel { width: root.build-w; }
                Rectangle { width: 1px; background: Palette.border; }
                ComparePanel { horizontal-stretch: 1; narrow: false; }
            }
            if !root.wide && root.tab == 0: BuildPanel { vertical-stretch: 1; }
            if !root.wide && root.tab == 1: ComparePanel { vertical-stretch: 1; narrow: root.avail-w < 600px; }
            // status messages: a slim bar that hides itself after a few seconds (tap to dismiss)
            if Backend.status != "" && Backend.dialog == 0: Rectangle {
                background: Palette.foreground.with-alpha(0.88);
                min-height: Ui.touch;
                TouchArea { clicked => { Backend.clear-status(); } }
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px;
                    Text { text: Backend.status; font-size: 13px; vertical-alignment: center; wrap: word-wrap; color: Palette.background; }
                }
            }
            // bottom navigation (thumb reach) on phones and tablets; hidden while typing
            if !root.wide && !root.tabs-on-top && !root.keyboard-up: Rectangle {
                height: 56px;
                background: Palette.alternate-background;
                Rectangle { y: 0px; height: 1px; background: Palette.border; }
                HorizontalLayout {
                    NavItem { text: "Build"; active: root.tab == 0; horizontal-stretch: 1; clicked => { root.tab = 0; } }
                    NavItem { text: Backend.headers.length > 0 ? "Compare (" + Backend.headers.length + ")" : "Compare"; active: root.tab == 1; horizontal-stretch: 1; clicked => { root.tab = 1; } }
                }
            }
        }

        // ---------------- dialogs (inside the FocusScope so Back/Escape reach it) ----------------
        if Backend.dialog == 6: DialogFrame {
            x: root.inset-left; y: root.inset-top; width: root.avail-w; height: root.height - root.inset-top; pad-bottom: root.inset-bottom;
            title: "Menu"; close => { Backend.dialog = 0; }
            PButton { text: "Favorites & saved comparisons"; clicked => { Backend.dialog = 1; } }
            PButton { text: "Export / share this comparison"; clicked => { Backend.export-open(0); } }
            PButton { text: "Edit this car's stats"; clicked => { Backend.open-edit(false); } }
            PButton { text: "Add a custom car"; clicked => { Backend.open-edit(true); } }
            PButton { text: "Import / export my overrides"; clicked => { Backend.overrides-open(); } }
            PButton { text: "Drivetrain loss settings"; clicked => { Backend.dialog = 5; } }
            Text { text: "Pitlane - figures are approximate; see the data accuracy notes in the README."; font-size: 12px; wrap: word-wrap; color: Palette.foreground.with-alpha(0.65); }
        }
        if Backend.dialog == 1: DialogFrame {
            x: root.inset-left; y: root.inset-top; width: root.avail-w; height: root.height - root.inset-top; pad-bottom: root.inset-bottom;
            title: "Favorites & saved"; close => { Backend.dialog = 0; }
            Section { text: "Save current comparison"; }
            HorizontalLayout {
                spacing: 8px;
                LineEdit { text <=> Backend.save-name; placeholder-text: "Name"; height: Ui.touch; horizontal-stretch: 1; }
                PButton { text: "Save"; width: 80px; clicked => { Backend.save-comparison(); } }
            }
            Section { text: "Saved comparisons"; }
            for s[i] in Backend.saved: HorizontalLayout {
                spacing: 6px;
                PButton { text: s.name + "  -  " + s.detail; horizontal-stretch: 1; clicked => { Backend.load-saved(i); } }
                PButton { text: "Delete"; width: 80px; clicked => { Backend.delete-saved(i); } }
            }
            if Backend.saved.length == 0: Text { text: "None yet."; color: Palette.foreground.with-alpha(0.6); }
            Section { text: "Favorite cars (tap to load into the selected slot)"; }
            for f[i] in Backend.favorites: PButton { text: f; clicked => { Backend.pick-fav(i); } }
            if Backend.favorites.length == 0: Text { text: "None yet - use the star on the Build screen."; wrap: word-wrap; color: Palette.foreground.with-alpha(0.6); }
        }
        if Backend.dialog == 2: DialogFrame {
            x: root.inset-left; y: root.inset-top; width: root.avail-w; height: root.height - root.inset-top; pad-bottom: root.inset-bottom;
            title: "Export / share"; close => { Backend.dialog = 0; }
            HorizontalLayout {
                spacing: 6px;
                PButton { text: "Text"; active: Backend.export-kind == 0; horizontal-stretch: 1; clicked => { Backend.export-open(0); } }
                PButton { text: "CSV"; active: Backend.export-kind == 1; horizontal-stretch: 1; clicked => { Backend.export-open(1); } }
                PButton { text: "PNG"; horizontal-stretch: 1; clicked => { Backend.export-png(); } }
            }
            HorizontalLayout {
                spacing: 6px;
                PButton { text: "Copy to clipboard"; horizontal-stretch: 1; clicked => { Backend.copy-export(); } }
                PButton { text: "Save file"; horizontal-stretch: 1; clicked => { Backend.save-export(); } }
            }
            TextEdit { text <=> Backend.export-text; read-only: true; height: 360px; font-size: 12px; }
        }
        if Backend.dialog == 3: DialogFrame {
            x: root.inset-left; y: root.inset-top; width: root.avail-w; height: root.height - root.inset-top; pad-bottom: root.inset-bottom;
            title: Backend.ed-heading; close => { Backend.dialog = 0; }
            if !Backend.ed-new: Text { text: "Make, model and year are fixed for an override; use 'Add a custom car' to change them."; font-size: 12px; wrap: word-wrap; color: Palette.foreground.with-alpha(0.7); }
            LabeledField { label: "Make"; value <=> Backend.ed-make; read-only: !Backend.ed-new; }
            LabeledField { label: "Model"; value <=> Backend.ed-model; read-only: !Backend.ed-new; }
            LabeledField { label: "Trim"; value <=> Backend.ed-trim; }
            LabeledField { label: "Year (1990-2026)"; value <=> Backend.ed-year; kind: InputType.number; read-only: !Backend.ed-new; }
            LabeledField { label: "Displacement (L)"; value <=> Backend.ed-disp; kind: InputType.decimal; }
            LabeledField { label: "Cylinders"; value <=> Backend.ed-cyl; kind: InputType.number; }
            HorizontalLayout { spacing: 8px; Text { text: "Aspiration"; min-width: 72px; preferred-width: 120px; horizontal-stretch: 0; vertical-alignment: center; font-size: 13px; color: Palette.foreground; } ComboBox { model: ["NA", "Turbo", "Supercharged", "Hybrid", "EV"]; current-index <=> Backend.ed-asp; height: Ui.touch; horizontal-stretch: 1; } }
            HorizontalLayout { spacing: 8px; Text { text: "Drivetrain"; min-width: 72px; preferred-width: 120px; horizontal-stretch: 0; vertical-alignment: center; font-size: 13px; color: Palette.foreground; } ComboBox { model: ["FWD", "RWD", "AWD", "4WD"]; current-index <=> Backend.ed-dt; height: Ui.touch; horizontal-stretch: 1; } }
            LabeledField { label: "Horsepower (crank)"; value <=> Backend.ed-hp; kind: InputType.number; }
            LabeledField { label: "Torque (lb-ft)"; value <=> Backend.ed-tq; kind: InputType.number; }
            LabeledField { label: "0-60 mph (s)"; value <=> Backend.ed-zs; kind: InputType.decimal; }
            LabeledField { label: "Curb weight (lb)"; value <=> Backend.ed-weight; kind: InputType.number; }
            LabeledField { label: "Redline (rpm, 0=?)"; value <=> Backend.ed-rl; kind: InputType.number; }
            if !Backend.ed-new: PButton { text: "Save as override of this car"; clicked => { Backend.edit-save(false); } }
            PButton { text: "Save as a new custom car"; clicked => { Backend.edit-save(true); } }
            if Backend.ed-can-reset: PButton { text: "Remove my override (back to bundled data)"; clicked => { Backend.edit-reset(); } }
        }
        if Backend.dialog == 4: DialogFrame {
            x: root.inset-left; y: root.inset-top; width: root.avail-w; height: root.height - root.inset-top; pad-bottom: root.inset-bottom;
            title: "Overrides import / export"; close => { Backend.dialog = 0; }
            Text { text: "Your edits and custom cars (RON text). Copy it to back it up, or paste text below and tap Import."; font-size: 12px; wrap: word-wrap; color: Palette.foreground.with-alpha(0.7); }
            HorizontalLayout { spacing: 6px; PButton { text: "Copy"; horizontal-stretch: 1; clicked => { Backend.overrides-copy(); } } PButton { text: "Import (replace)"; horizontal-stretch: 1; clicked => { Backend.overrides-import(); } } }
            TextEdit { text <=> Backend.overrides-text; height: 380px; font-size: 12px; }
        }
        if Backend.dialog == 5: DialogFrame {
            x: root.inset-left; y: root.inset-top; width: root.avail-w; height: root.height - root.inset-top; pad-bottom: root.inset-bottom;
            title: "Drivetrain loss (%)"; close => { Backend.dialog = 0; }
            Text { text: "Used when 'Wheel' power is selected. Defaults: 12 / 15 / 18 / 20 / 8."; font-size: 12px; wrap: word-wrap; color: Palette.foreground.with-alpha(0.7); }
            LabeledField { label: "FWD/RWD manual"; value <=> Backend.loss-2wd-man; kind: InputType.decimal; }
            LabeledField { label: "FWD/RWD auto"; value <=> Backend.loss-2wd-auto; kind: InputType.decimal; }
            LabeledField { label: "AWD/4WD manual"; value <=> Backend.loss-awd-man; kind: InputType.decimal; }
            LabeledField { label: "AWD/4WD auto"; value <=> Backend.loss-awd-auto; kind: InputType.decimal; }
            LabeledField { label: "EV"; value <=> Backend.loss-ev; kind: InputType.decimal; }
            PButton { text: "Apply"; clicked => { Backend.settings-save(); } }
        }
    }
}
